# ============================================================
# TRACE Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to version control.
# ============================================================

# Server
PORT=3001
CLIENT_URL=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# Google Gemini AI
GEMINI_API_KEY=

# Firebase Firestore (optional — leave blank to use local in-memory store)
# Provide the full JSON string of your service account credentials
FIREBASE_SERVICE_ACCOUNT=
