# ============================================================
# TRACE Frontend — Environment Variables
# Copy this file to .env (for local dev) and set accordingly.
# NEVER commit your real .env to version control.
# ============================================================

# Backend API base URL (no trailing slash)
# Local: http://localhost:3001
# Production: https://your-railway-backend-url
VITE_API_URL=http://localhost:3001

# Socket.IO server URL (usually same as VITE_API_URL)
VITE_SOCKET_URL=http://localhost:3001
